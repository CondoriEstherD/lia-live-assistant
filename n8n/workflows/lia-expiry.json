      "position": [
        660,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "c2ac33c6-8ad9-4356-9de8-c936b0237046",
              "leftValue": "={{ ['expired', 'cancelled', 'reminders', 'promoted'].some((k) => Number($json[k] ?? 0) > 0) }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "49ce58db-4b01-4563-aea1-5726d7e7872c",
