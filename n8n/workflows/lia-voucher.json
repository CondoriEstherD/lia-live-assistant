    {
      "id": "ed2faa00-f5ce-4356-9dc5-87044963ed03",
      "name": "Build AI request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "const prompt = \"Esta imagen deberia ser un comprobante de pago bancario o de billetera movil de Bolivia (QR, transferencia).\\nExtrae y responde SOLO un objeto JSON con estas claves:\\n\\\"payer_name\\\": nombre completo de la persona que PAGO (ordenante / originante / remitente / \\\"de\\\"), tal como aparece; no el beneficiario.\\n\\\"amount\\\": monto pagado como numero (ej. 150.00).\\n\\\"paid_at\\\": fecha y hora del pago en ISO 8601 con zona -04:00.\\n\\\"reference\\\": numero de transaccion o comprobante.\\nSi un dato no se ve con claridad usa null. Si la imagen no es un comprobante de pago, todas las claves en null.\\nNo inventes datos.\";\nconst item = $input.first();\nif (!item.binary || !item.binary.data) return [{ json: { hasImage: false } }];\nconst buffer = await this.helpers.getBinaryDataBuffer(0, 'data');\nconst mime = item.binary.data.mimeType || 'image/jpeg';\nconst body = {\n  model: 'gpt-6-luna',\n  input: [{\n    role: 'user',\n    content: [\n      { type: 'input_text', text: prompt },\n      { type: 'input_image', image_url: `data:${mime};base64,${buffer.toString('base64')}` },\n    ],\n  }],\n};\nreturn [{ json: { hasImage: true, body } }];"
      }
    },
    {
      "id": "d537d21a-765d-41f6-b29e-26c0f63e6fc1",
      "name": "Read voucher with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/responses",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "openAiApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body || { model: \"gpt-6-luna\", input: \"{}\" }) }}",
        "options": {
          "timeout": 120000
        }
      },
      "credentials": {
        "openAiApi": {
          "id": "__CRED:OpenAI Lia__",
          "name": "OpenAI Lia"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "id": "322fce0a-8f79-4e52-9035-8026012328e1",
      "name": "Parse voucher",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "//@include lia-messages.js\n\nconst hasImage = $('Build AI request').first().json.hasImage === true;\nconst response = $json || {};\nconst texts = [];\nfor (const out of response.output || []) {\n  for (const part of out.content || []) if (typeof part.text === 'string') texts.push(part.text);\n}\nif (typeof response.output_text === 'string') texts.push(response.output_text);\nconst voucher = hasImage ? parseVoucherExtraction(texts.join('\\n')) : parseVoucherExtraction('');\nreturn [{ json: { voucher, raw: { ai_text: texts.join('\\n').slice(0, 2000), has_image: hasImage } } }];"
      }
    },
    {
      "id": "1f486365-dcd9-4421-af55-3efda930f4ab",
      "name": "RPC register voucher",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/lia_register_voucher",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_wa_phone_number_id: $('Start').first().json.phoneNumberId, p_customer_phone: $('Start').first().json.from, p_payer_name: $json.voucher.payer_name, p_amount: $json.voucher.amount, p_paid_at: $json.voucher.paid_at, p_reference: $json.voucher.reference, p_voucher_url: 'whapi-media:' + $('Start').first().json.mediaId, p_raw: $json.raw }) }}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:Supabase Lia__",
          "name": "Supabase Lia"
        }
      }
    },
    {
      "id": "afd25542-5724-4909-95d4-9ec4ca6d7d0d",
      "name": "Build voucher reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
