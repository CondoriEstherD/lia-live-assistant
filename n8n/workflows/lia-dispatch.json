{
  "name": "lia-dispatch",
  "nodes": [
    {
      "id": "f2781337-18db-490d-8ac2-71307afada70",
      "name": "Every 10 seconds",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        -100
      ],
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "seconds",
              "secondsInterval": 10
            }
          ]
        }
      },
      "disabled": true
    },
    {
      "id": "7cc6dbaf-8496-457f-aecf-516b16e9ade3",
      "name": "Start",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.1,
      "position": [
        0,
        100
      ],
      "parameters": {
        "inputSource": "passthrough"
      }
    },
    {
      "id": "703f945e-59b6-4883-97c3-668e61947f1b",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        0
      ],
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "52afed82-a2c8-49cd-a75f-28b1a356c189",
              "name": "supabaseUrl",
              "value": "__SUPABASE_URL__",
              "type": "string"
            },
            {
              "id": "d48173c3-51ec-4733-90ce-66b7b410e8a5",
              "name": "waGraphVersion",
              "value": "__WA_GRAPH_VERSION__",
              "type": "string"
            },
            {
              "id": "1b796d75-559a-41ee-b234-f8bad05777ef",
              "name": "waVerifyToken",
              "value": "__WA_VERIFY_TOKEN__",
              "type": "string"
            },
            {
              "id": "21a63730-9e7b-4e47-b444-d50d1e2bec05",
              "name": "payBaseUrl",
              "value": "__N8N_BASE_URL__/webhook/lia-pay",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      }
    },
    {
      "id": "c63d778b-4e7b-4547-91d8-6fd94a9258a3",
      "name": "RPC claim notifications",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/lia_claim_notifications",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_limit: 20 }) }}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:Supabase Lia__",
          "name": "Supabase Lia"
        }
      },
      "executeOnce": true
    },
    {
      "id": "ff66f37d-0705-4d3a-b46e-e9b899eef1b6",
      "name": "Build message",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "//@include lia-messages.js\n\n// The HTTP node already splits the returned rows array into one item per row.\nconst cfg = $('Config').first().json;\nconst config = { ...DEFAULT_CONFIG, payBaseUrl: cfg.payBaseUrl };\nreturn $input.all()\n  .map((item, index) => ({ row: item.json, index }))\n  .filter(({ row }) => row && row.id !== undefined && row.id !== null)\n  .map(({ row, index }) => ({\n    json: { notification: row, body: toWhapi(buildNotificationMessage(row, config)) },\n    pairedItem: { item: index },\n  }));"
      }
    },
    {
      "id": "9307c90f-1bc0-4abc-8ab4-1ec8680c0d6d",
      "name": "Has message",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        880,
        0
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "08eb4452-a227-4a44-b9e4-76bca2ccb1c9",
              "leftValue": "={{ $json.body !== null && $json.body !== undefined }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
    {
      "id": "ff1914f7-b225-4690-a430-7db96ee2b72e",
      "name": "Send WhatsApp",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1100,
        -100
      ],
      "parameters": {
        "method": "POST",
        "url": "=https://gate.whapi.cloud/{{ $json.body.path }}",
        "authentication": "genericCredentialType",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.body.body) }}",
        "options": {},
        "genericAuthType": "httpHeaderAuth"
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "__CRED:Whapi Lia__",
          "name": "Whapi Lia"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "id": "4119a4f6-446f-4717-adfe-bd7c702931dd",
      "name": "Send failed",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        1320,
        -200
      ],
      "parameters": {}
    },
    {
      "id": "67089f33-9c18-4d6e-a80c-97af3dfc2c0b",
      "name": "RPC mark sent",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1320,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/lia_mark_notification_sent",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_id: $('Build message').item.json.notification.id }) }}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:Supabase Lia__",
          "name": "Supabase Lia"
        }
      },
      "onError": "continueRegularOutput"
    }
  ],
  "connections": {
    "Every 10 seconds": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Start": {
      "main": [
        [
          {
            "node": "Config",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Config": {
      "main": [
        [
          {
            "node": "RPC claim notifications",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "RPC claim notifications": {
      "main": [
        [
          {
            "node": "Build message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Build message": {
      "main": [
        [
          {
            "node": "Has message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Has message": {
      "main": [
        [
          {
            "node": "Send WhatsApp",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "RPC mark sent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Send WhatsApp": {
      "main": [
        [
          {
            "node": "RPC mark sent",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Send failed",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "America/La_Paz"
  }
}
