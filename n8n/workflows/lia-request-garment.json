        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_wa_phone_number_id: $('Start').first().json.phoneNumberId, p_customer_phone: $('Start').first().json.from, p_customer_name: $('Start').first().json.name, p_code: $('Start').first().json.code, p_wa_message_id: $('Start').first().json.waMessageId, p_message_ts: $('Start').first().json.messageTs }) }}",
