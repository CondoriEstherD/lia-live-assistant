      "id": "63c7af3d-6407-4655-b34c-4f5aec545349",
      "name": "Build reply",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "jsCode": "//@include lia-messages.js\n\nconst input = $('Start').first().json;\nconst cfg = $('Config').first().json;\nconst result = $('RPC request garment').first().json;\nconst config = { ...DEFAULT_CONFIG, payBaseUrl: cfg.payBaseUrl };\nreturn [{ json: { result, body: buildRequestReply(input.from, result, config) } }];"
      }
    },
