      "id": "e6866b39-4867-4058-b7a3-1bf229d73928",
      "name": "RPC search catalog",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        440,
        0
      ],
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config').first().json.supabaseUrl }}/rest/v1/rpc/lia_search_catalog",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "supabaseApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ p_wa_phone_number_id: $('Start').item.json.phoneNumberId, p_query: $('Start').item.json.query, p_limit: 5 }) }}",
        "options": {}
      },
      "credentials": {
        "supabaseApi": {
          "id": "__CRED:Supabase Lia__",
          "name": "Supabase Lia"
        }
      }
    },
    {
      "id": "867fdcd8-49ae-4d2a-809c-4fb809708615",
      "name": "Format results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        660,
        0
      ],
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Compact garment list for the agent (no internal ids or photo urls).\nconst items = ($json.items ?? []).map((g) => ({\n  code: g.code,\n  name: g.name,\n  size: g.size,\n  color: g.color,\n  price: g.price,\n  description: g.description,\n}));\nreturn { json: { count: items.length, items } };"
      }
    }
  ],
  "connections": {
    "Start": {
